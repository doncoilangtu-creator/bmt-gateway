---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import LeadForm from '../components/LeadForm';
import ResidenceCollection from '../components/ResidenceCollection';
import TownhouseCollection from '../components/TownhouseCollection';
import LocationStory from '../components/LocationStory.astro';
import AmenityMasterplan from '../components/AmenityMasterplan.astro';
import ManifestoBackground from '../components/ManifestoBackground';
import InquiryPhoneCta from '../components/InquiryPhoneCta';
import {
  lowriseProducts,
  projectProfile,
  residenceUnits,
} from '../data/narrative';
import { project } from '../data/project';

const hotlineDisplay = project.hotline;
const hotlineTel = project.hotline.replace(/\s+/g, '');
const zaloHref = `https://zalo.me/${hotlineTel}`;

const manifesto = [
  { index: '01', href: '#overview', text: 'Cửa ngõ đô thị trên trục Nguyễn Chí Thanh' },
  { index: '02', href: '#overview', text: 'Cấu trúc sống cân bằng giữa cao tầng và thấp tầng' },
  { index: '03', href: '#amenities', text: 'Mảng xanh đi vào từng lớp kiến trúc' },
  { index: '04', href: '#townhouses', text: 'Phố thương mại nối dài nhịp sống nội khu' },
  { index: '05', href: '#residences', text: 'Không gian ở phù hợp nhiều thế hệ' },
  { index: '06', href: '#inquiry', text: 'Điểm gặp mới của cộng đồng Buôn Ma Thuột' },
];
---
<MainLayout title="EraCity - Cửa ngõ đô thị mới giữa cao nguyên">
  <Header />
  <script>
    import '../scripts/sohoMotion';
  </script>

  <main id="top" class="soho-v2-page">
    <section class="v2-hero" data-hero-motion>
      <picture class="v2-hero-media">
        <source media="(max-width: 700px)" srcset="/images/edited/hero.webp" />
        <img data-hero-image src="/images/edited/hero.webp" alt="Phối cảnh tổng thể EraCity" fetchpriority="high" data-editable-img="hero" />
      </picture>
      <div class="v2-hero-shade" aria-hidden="true"></div>
      <div class="v2-hero-lock">
        <div class="v2-hero-left"><h1 data-hero-line>BẢN SẮC<br />CAO NGUYÊN</h1></div>
        <div class="v2-hero-project" data-hero-copy><strong>Era</strong><span>City</span></div>
        <div class="v2-hero-right"><p data-hero-line>NHỊP SỐNG<br />ĐÔ THỊ MỚI</p></div>
        <a class="v2-hero-cta" href="#inquiry" data-hero-copy>Nhận thông tin dự án</a>
      </div>
      <div class="v2-hero-meta" data-hero-copy><span>Nguyễn Chí Thanh, Tân An</span><span>Buôn Ma Thuột</span></div>
    </section>

    <section class="v2-manifesto" data-chapter>
      <ManifestoBackground client:idle />
      <header class="v2-manifesto-head">
        <p class="v2-editorial">Sáu chuyển động của một địa chỉ mới</p>
        <h2>NƠI KIẾN TRÚC, CẢNH QUAN VÀ GIAO THƯƠNG CÙNG HỘI TỤ</h2>
      </header>
      <nav class="v2-manifesto-grid" aria-label="Khám phá câu chuyện dự án">
        {manifesto.map((item, index) => (
          <a class:list={['v2-manifesto-item', { 'is-featured': index === 0 }]} href={item.href}>
            <span>{item.index}</span><strong>{item.text}</strong>
          </a>
        ))}
      </nav>
    </section>

    <section id="overview" class="v2-overview" data-chapter>
      <img src="/images/edited/landscape.webp" alt="ConceptDesign p003 002 1988x1406 - EraCity" loading="eager" data-editable-img="landscape" />
      <div class="v2-overview-shade" aria-hidden="true"></div>
      <article class="v2-overview-panel">
        <p class="v2-editorial">Tổng quan dự án</p>
        <h2>MỘT CẤU TRÚC ĐÔ THỊ HOÀN CHỈNH</h2>
        <dl class="v2-profile">
          {projectProfile.slice(1).map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
      </article>
      <div class="v2-overview-facts" data-count-group>
        <div><strong data-count-value="4,86 ha">4,86 ha</strong><span>Quy mô</span></div>
        <div><strong data-count-value="984">984</strong><span>Căn hộ</span></div>
        <div><strong data-count-value="152">152</strong><span>Thấp tầng</span></div>
      </div>
    </section>

    <section class="v2-identity" data-chapter>
      <article class="v2-identity-copy">
        <p class="v2-editorial">Biểu tượng của một nhịp sống mới</p>
        <h2>CỬA NGÕ GIỮA THÀNH PHỐ CAO NGUYÊN</h2>
        <p>Tại cửa ngõ phía Bắc Buôn Ma Thuột, dự án đón những dòng chuyển động từ trung tâm, sân bay và Quốc lộ 14. Kiến trúc hiện đại được đặt trong nền cảnh quan nhiệt đới, tạo nên một địa chỉ sống vừa kết nối vừa có khoảng lùi riêng.</p>
        <div class="v2-identity-mark" aria-hidden="true">ERA</div>
      </article>
      <figure class="v2-identity-media" data-media-reveal><img src="/images/new-media/dusk-facade.webp" alt="Phối cảnh mặt đứng kiến trúc EraCity" loading="eager" /></figure>
    </section>

    <LocationStory />

    <section class="cinematic-video" data-cinematic-video aria-label="Phim giới thiệu EraCity">
      <div class="cinematic-stage" data-cinematic-stage>
        <div class="cinematic-curtain cinematic-curtain-top" data-cinematic-curtain-top aria-hidden="true"></div>
        <div class="cinematic-frame" data-cinematic-frame>
          <video
            data-cinematic-media
            data-editable-img="poster"
            src="/videos/bmt-gateway-0616-hero.mp4"
            poster="/images/new-media/overview-aerial.webp"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Phim phối cảnh kiến trúc và không gian sống EraCity"
          ></video>
          <div class="cinematic-vignette" aria-hidden="true"></div>
          <div class="cinematic-overlay" data-cinematic-overlay aria-hidden="true">
            <div class="cinematic-overlay-wordmark">
              <span class="cinematic-overlay-kicker">Cửa ngõ cao nguyên</span>
              <strong>Era</strong>
              <span class="cinematic-overlay-sub">City</span>
            </div>
            <div class="cinematic-overlay-rule"></div>
            <p>Kiến trúc trong chuyển động</p>
          </div>
          <p class="cinematic-caption">EraCity <span>Kiến trúc trong chuyển động</span></p>
        </div>
        <div class="cinematic-curtain cinematic-curtain-bottom" data-cinematic-curtain-bottom aria-hidden="true"></div>
      </div>
    </section>

    <AmenityMasterplan />
    <section id="amenities" class="v2-amenities" data-chapter>
      <img src="/images/edited/pool.webp" alt="Phối cảnh cảnh quan và tiện ích EraCity" loading="eager" data-editable-img="pool" />
      <div class="v2-amenities-shade" aria-hidden="true"></div>
      <div class="v2-amenities-title">
        <p class="v2-editorial">Hệ cảnh quan đa lớp</p>
        <h2>MỖI NGÀY LÀ MỘT HÀNH TRÌNH TRONG MẢNG XANH</h2>
      </div>
      </section>

    <section id="residences" class="v2-collection residences" data-chapter>
      <header class="v2-collection-head residence-heading">
        <p class="v2-editorial">01 / Residence Collection</p>
        <h2>MẶT BẰNG CĂN HỘ</h2>
        <p>Khám phá cách tổ chức không gian, diện tích và công năng của từng loại căn hộ tại EraCity.</p>
      </header>
      <ResidenceCollection units={residenceUnits} client:load />
    </section>

    <section id="townhouses" class="v2-collection residences townhouses" data-chapter>
      <header class="v2-collection-head residence-heading">
        <p class="v2-editorial">02 / Lowrise Collection</p>
        <h2>MẶT BẰNG NHÀ PHỐ</h2>
        <p>Đặt mặt bằng nguồn StudioMilou cạnh phối cảnh để nhìn rõ cấu trúc, công năng và bối cảnh của từng loại hình thấp tầng.</p>
      </header>
      <TownhouseCollection products={lowriseProducts} client:load />
    </section>

    <section id="inquiry" class="v2-inquiry" data-chapter>
      <article class="v2-inquiry-copy">
        <p class="v2-editorial">Khởi đầu một cuộc gặp</p>
        <h2>NHẬN THÔNG TIN PHÙ HỢP VỚI BẠN</h2>
        <p>Nhận mặt bằng nguồn, thông tin sản phẩm và tư vấn theo nhu cầu sở hữu.</p>
        <InquiryPhoneCta client:idle />
      </article>
      <LeadForm client:load source="soho-v2-inquiry" />
    </section>
  </main>

  <div class="floating-cta" role="complementary" aria-label="Liên hệ nhanh">
    <a class="floating-cta-btn" href={`tel:${hotlineTel}`} aria-label={`Gọi hotline tư vấn ${hotlineDisplay}`}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.4 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2Z"/></svg>
      <span>Hotline</span>
    </a>
    <a class="floating-cta-btn floating-cta-zalo" href={zaloHref} target="_blank" rel="noreferrer" aria-label={`Chat Zalo tư vấn ${hotlineDisplay}`}>
      <img src="/images/zalo-logo9.webp" alt="Zalo" width="34" height="34" style="object-fit:contain;width:34px;height:34px" />
      <span>Zalo</span>
    </a>
  </div>

  <footer class="footer-soho v2-footer">
    <div class="footer-brand"><strong>Era</strong><span>City</span></div>
    <div class="footer-contact">
      <p class="footer-contact-title">Liên hệ dự án</p>
      <p>{project.location}</p>
      <p>Chủ đầu tư: {project.developer}</p>
      <p>Hotline: <a href={`tel:${hotlineTel}`}>{hotlineDisplay}</a></p>
      <p>Email: <a href={`mailto:${project.email}`}>{project.email}</a></p>
      <p>Zalo tư vấn: <a href={zaloHref} target="_blank" rel="noreferrer">{hotlineDisplay}</a></p>
    </div>
    <div class="footer-cta">
      <a class="btn btn-ghost footer-register" href="#inquiry">Đăng ký nhận tin</a>
      <p class="footer-note">Thông tin và phối cảnh mang tính tham khảo theo hồ sơ thiết kế. Chi tiết chính thức căn cứ tài liệu được chủ đầu tư phê duyệt.</p>
    </div>
  </footer>

  <script>
    // ——— Chế độ chỉnh ảnh: slides khối giới thiệu + đổi ảnh trên trang ———
    // Bật: thêm ?edit=1 vào URL (hoặc localStorage bmt_site_edit=1).
    // Quy trình: ?edit=1 → thêm/đổi ảnh → Lưu (localStorage) → Xuất JSON dán vào chat.
    (() => {
      const LS_SLIDES = 'bmt_identity_slides';
      const LS_IMAGES = 'bmt_site_images';
      const DEFAULT_SLIDES = [{ src: '/images/edited/identity-01.webp', alt: 'Presentation1 p049 508 1988x1406 - EraCity' }, { src: '/images/edited/identity-02.webp', alt: 'Presentation1 p013 016 1989x1407 - EraCity' }, { src: '/images/edited/identity-03.webp', alt: 'Presentation1 p020 168 1989x1406 - EraCity' }, { src: '/images/edited/identity-04.webp', alt: 'Presentation1 p043 500 1989x1404 - EraCity' }];
      const isEdit = new URLSearchParams(location.search).has('edit') || localStorage.getItem('bmt_site_edit') === '1';

      const figure = document.querySelector('.v2-identity-media');
      if (!figure) return;

      const readSlides = () => {
        try {
          const s = JSON.parse(localStorage.getItem(LS_SLIDES) || 'null');
          if (Array.isArray(s) && s.length && s.every(x => x && typeof x.src === 'string' && x.src)) return s;
        } catch (e) {}
        return DEFAULT_SLIDES.map(x => ({ ...x }));
      };
      let slides = readSlides();
      let dirty = false;

      // Nén ảnh upload: canvas về max 2400px, JPEG q88 → base64 (đủ nét cho khối full-bleed 1905px+)
      const compressImage = (file) => new Promise((resolve, reject) => {
        const url = URL.createObjectURL(file);
        const img = new Image();
        img.onload = () => {
          const scale = Math.min(1, 2400 / Math.max(img.naturalWidth, img.naturalHeight));
          const w = Math.max(1, Math.round(img.naturalWidth * scale));
          const h = Math.max(1, Math.round(img.naturalHeight * scale));
          const c = document.createElement('canvas');
          c.width = w; c.height = h;
          c.getContext('2d').drawImage(img, 0, 0, w, h);
          URL.revokeObjectURL(url);
          resolve(c.toDataURL('image/jpeg', 0.88));
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject(new Error('Không đọc được ảnh')); };
        img.src = url;
      });

      const altFromSrc = (src) => {
        if (src.startsWith('data:')) return 'Ảnh tải lên - EraCity';
        const leaf = src.split('/').pop() || '';
        return leaf.replace(/\.[a-z0-9]+$/i, '').replace(/[-_]+/g, ' ') + ' - EraCity';
      };

      // Popup chọn ảnh: upload (nén base64) hoặc URL /images/...
      const openPicker = (onPick) => {
        const modal = document.createElement('div');
        modal.className = 'v2-img-modal';
        modal.innerHTML = `
          <div class="v2-img-modal-box" role="dialog" aria-label="Chọn ảnh">
            <p>Tải ảnh lên (tự nén ≤2400px, JPEG q88 — đủ nét full-bleed) hoặc dán URL ảnh có sẵn dạng /images/...</p>
            <div class="v2-img-modal-row"><button type="button" data-upload>📁 Chọn file ảnh</button><span data-file-name></span></div>
            <div class="v2-img-modal-row"><input type="text" data-url value="/images/new-media/overview-aerial.webp" /><button type="button" data-use-url>Dùng URL</button></div>
            <div class="v2-img-modal-row"><button type="button" data-close>Đóng</button></div>
          </div>`;
        document.body.appendChild(modal);
        const close = () => modal.remove();
        const fileInput = document.createElement('input');
        fileInput.type = 'file'; fileInput.accept = 'image/*'; fileInput.hidden = true;
        modal.appendChild(fileInput);
        modal.querySelector('[data-upload]').addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', async () => {
          const f = fileInput.files && fileInput.files[0];
          if (!f) return;
          const nameEl = modal.querySelector('[data-file-name]');
          if (nameEl) nameEl.textContent = 'Đang nén…';
          try {
            const src = await compressImage(f);
            close();
            onPick({ src, alt: altFromSrc(f.name) });
          } catch (err) {
            if (nameEl) nameEl.textContent = 'Lỗi đọc ảnh';
          }
        });
        modal.querySelector('[data-use-url]').addEventListener('click', () => {
          const url = modal.querySelector('[data-url]').value.trim();
          if (!url) return;
          close();
          onPick({ src: url, alt: altFromSrc(url) });
        });
        modal.querySelector('[data-close]').addEventListener('click', close);
        modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
      };

      // Copy text vào clipboard (fallback execCommand cho http)
      const copyText = async (text) => {
        try { await navigator.clipboard.writeText(text); return true; } catch (e) {}
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0';
        document.body.appendChild(ta);
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch (e) {}
        ta.remove();
        return ok;
      };

      // ——— Chế độ xem: ảnh tĩnh (1 slide) hoặc carousel crossfade (≥2 slide) ———
      let timer = null;
      let active = 0;
      const stopAuto = () => { if (timer) { clearInterval(timer); timer = null; } };
      const startAuto = () => {
        stopAuto();
        if (isEdit || slides.length < 2) return;
        timer = setInterval(() => { if (!document.hidden) setActive(active + 1); }, 4500);
      };
      const setActive = (i) => {
        const imgs = figure.querySelectorAll('.idm-stage img');
        if (!imgs.length) return;
        active = ((i % imgs.length) + imgs.length) % imgs.length;
        imgs.forEach((im, k) => im.classList.toggle('is-active', k === active));
        figure.querySelectorAll('.idm-dots button').forEach((d, k) => d.classList.toggle('is-active', k === active));
      };
      const renderView = () => {
        stopAuto();
        figure.querySelectorAll('.idm-stage,.idm-dots,.idm-arrow').forEach(el => el.remove());
        let baseImg = figure.querySelector(':scope > img');
        if (slides.length < 2) {
          if (!baseImg) {
            baseImg = document.createElement('img');
            baseImg.loading = 'eager';
            figure.appendChild(baseImg);
          }
          baseImg.src = slides[0].src;
          baseImg.alt = slides[0].alt || DEFAULT_SLIDES[0].alt;
          return;
        }
        if (baseImg) baseImg.remove();
        const stage = document.createElement('div');
        stage.className = 'idm-stage';
        slides.forEach((s, i) => {
          const im = document.createElement('img');
          im.src = s.src;
          im.alt = `Phối cảnh ${i + 1} - EraCity`;
          im.loading = i === 0 ? 'eager' : 'lazy';
          if (i === active) im.classList.add('is-active');
          stage.appendChild(im);
        });
        figure.appendChild(stage);
        const dots = document.createElement('div');
        dots.className = 'idm-dots';
        slides.forEach((s, i) => {
          const d = document.createElement('button');
          d.type = 'button';
          d.setAttribute('aria-label', `Xem phối cảnh ${i + 1}`);
          if (i === active) d.classList.add('is-active');
          d.addEventListener('click', () => { setActive(i); startAuto(); });
          dots.appendChild(d);
        });
        figure.appendChild(dots);
        [['prev', '‹', 'Ảnh trước', -1], ['next', '›', 'Ảnh sau', 1]].forEach(([cls, glyph, label, step]) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = `idm-arrow ${cls}`;
          b.textContent = glyph;
          b.setAttribute('aria-label', label);
          b.addEventListener('click', () => { setActive(active + step); startAuto(); });
          figure.appendChild(b);
        });
        if (!figure.dataset.idmHoverBound) {
          figure.dataset.idmHoverBound = '1';
          figure.addEventListener('mouseenter', stopAuto);
          figure.addEventListener('mouseleave', startAuto);
          document.addEventListener('visibilitychange', () => { document.hidden ? stopAuto() : startAuto(); });
        }
        startAuto();
      };
      renderView();

      // ——— Amenities: ảnh nền chạy slide (localStorage bmt_amenities_slides) ———
      const LS_AMEN = 'bmt_amenities_slides_v2';
      const DEFAULT_AM_SLIDES = [
    { src: '/images/edited/amenities-02.webp', alt: 'Khuôn viên sân vườn xanh mát & hồ cảnh quan EraCity - StudioMilou' },
    { src: '/images/edited/amenities-03.webp', alt: 'Đường dạo rợp bóng mát & chòi gỗ công viên EraCity - StudioMilou' },
    { src: '/images/edited/amenities-04.webp', alt: 'Công viên cây xanh & bãi cỏ sinh thái EraCity - StudioMilou' }
  ];
      const amSection = document.querySelector('.v2-amenities');
      const readAmSlides = () => {
        try {
          const s = JSON.parse(localStorage.getItem(LS_AMEN) || 'null');
          if (Array.isArray(s) && s.length && s.every(x => x && typeof x.src === 'string' && x.src)) return s;
        } catch (e) {}
        return DEFAULT_AM_SLIDES.map(x => ({ ...x }));
      };
      let amSlides = readAmSlides();
      let amTimer = null;
      let amActive = 0;
      const amStop = () => { if (amTimer) { clearInterval(amTimer); amTimer = null; } };
      const amStart = () => {
        amStop();
        if (isEdit || amSlides.length < 2) return;
        amTimer = setInterval(() => { if (!document.hidden) amSet(amActive + 1); }, 4500);
      };
      const amSet = (i) => {
        const imgs = amSection.querySelectorAll('.am-stage img');
        if (!imgs.length) return;
        amActive = ((i % imgs.length) + imgs.length) % imgs.length;
        imgs.forEach((im, k) => im.classList.toggle('is-active', k === amActive));
        amSection.querySelectorAll('.am-dots button').forEach((d, k) => d.classList.toggle('is-active', k === amActive));
      };
      const amRenderView = () => {
        if (!amSection) return;
        amStop();
        amSection.querySelectorAll('.am-stage,.am-dots').forEach(el => el.remove());
        let baseImg = amSection.querySelector(':scope > img');
        if (amSlides.length < 2) {
          if (!baseImg) {
            baseImg = document.createElement('img');
            baseImg.loading = 'eager';
            baseImg.setAttribute('data-editable-img', 'pool');
            amSection.insertBefore(baseImg, amSection.firstChild);
          }
          baseImg.src = amSlides[0].src;
          baseImg.alt = amSlides[0].alt || DEFAULT_AM_SLIDES[0].alt;
          return;
        }
        if (baseImg) baseImg.remove();
        const stage = document.createElement('div');
        stage.className = 'am-stage';
        amSlides.forEach((s, i) => {
          const im = document.createElement('img');
          im.src = s.src;
          im.alt = s.alt || `Phối cảnh tiện ích ${i + 1} - EraCity`;
          im.loading = i === 0 ? 'eager' : 'lazy';
          if (i === amActive) im.classList.add('is-active');
          stage.appendChild(im);
        });
        amSection.insertBefore(stage, amSection.firstChild);
        const dots = document.createElement('div');
        dots.className = 'am-dots';
        amSlides.forEach((s, i) => {
          const d = document.createElement('button');
          d.type = 'button';
          d.setAttribute('aria-label', `Xem ảnh tiện ích ${i + 1}`);
          if (i === amActive) d.classList.add('is-active');
          d.addEventListener('click', () => { amSet(i); amStart(); });
          dots.appendChild(d);
        });
        amSection.appendChild(dots);
        if (!amSection.dataset.amHoverBound) {
          amSection.dataset.amHoverBound = '1';
          amSection.addEventListener('mouseenter', amStop);
          amSection.addEventListener('mouseleave', amStart);
          document.addEventListener('visibilitychange', () => { document.hidden ? amStop() : amStart(); });
        }
        amStart();
      };
      amRenderView();

      // ——— Đổi ảnh trên trang: áp dụng ảnh đã lưu (chạy cả chế độ thường) ———
      const editableImgs = Array.from(document.querySelectorAll('[data-editable-img]'));
      const readImages = () => { try { return JSON.parse(localStorage.getItem(LS_IMAGES) || '{}'); } catch (e) { return {}; } };
      
      const applySiteImage = (key, data) => {
        if (!data || !data.src) return;
        const el = document.querySelector(`[data-editable-img="${key}"]`);
        if (!el) return;
        if (key === 'hero') {
          if (el instanceof HTMLImageElement) el.src = data.src;
          if (data.alt && el instanceof HTMLImageElement) el.alt = data.alt;
          const pic = el.closest('picture');
          if (pic) {
            pic.querySelectorAll('source').forEach(srcEl => {
              srcEl.srcset = data.src;
            });
          }
        } else if (key === 'poster') {
          if (el instanceof HTMLVideoElement) {
            el.poster = data.src;
          }
        } else {
          if (el instanceof HTMLImageElement) {
            el.src = data.src;
            if (data.alt) el.alt = data.alt;
          }
        }
      };

      const currentSavedImages = readImages();
      editableImgs.forEach(el => {
        const key = el.dataset.editableImg;
        if (key && currentSavedImages[key]) {
          applySiteImage(key, currentSavedImages[key]);
        }
      });

      if (!isEdit) return;
      document.body.classList.add('v2-edit-mode');

      // Toolbar nổi trên figure (pattern giống AmenityMasterplan)
      const toolbar = document.createElement('div');
      toolbar.className = 'v2-edit-toolbar';
      toolbar.innerHTML = `
        <span class="v2-edit-tag">✦ CHỈNH ẢNH</span>
        <button type="button" data-add>+ Thêm ảnh</button>
        <button type="button" data-save>💾 Lưu</button>
        <button type="button" data-export>📋 Xuất JSON</button>
        <button type="button" data-reset>↺ Reset</button>
        <span class="v2-edit-hint" data-hint>Thêm/đổi/xóa slide, kéo thả đổi thứ tự → Lưu.</span>`;
      figure.appendChild(toolbar);
      const hint = toolbar.querySelector('[data-hint]');
      const markDirty = () => { dirty = true; if (hint) hint.textContent = 'Chưa lưu — bấm 💾 Lưu.'; };

      // Panel thumbnail slide (đổi / xóa / kéo thả đổi thứ tự)
      const panel = document.createElement('div');
      panel.className = 'v2-slides-panel';
      figure.appendChild(panel);
      const renderPanel = () => {
        panel.innerHTML = '';
        slides.forEach((s, i) => {
          const thumb = document.createElement('div');
          thumb.className = 'v2-slide-thumb';
          thumb.draggable = true;
          const im = document.createElement('img');
          im.src = s.src; im.alt = s.alt || `Slide ${i + 1}`;
          const actions = document.createElement('div');
          actions.className = 'thumb-actions';
          const btnChange = document.createElement('button');
          btnChange.type = 'button'; btnChange.textContent = 'Đổi';
          btnChange.addEventListener('click', () => openPicker(({ src, alt }) => {
            slides[i] = { src, alt };
            markDirty(); renderPanel(); renderView();
            if (hint) hint.textContent = `Đã đổi slide ${i + 1} — chưa lưu.`;
          }));
          const btnDel = document.createElement('button');
          btnDel.type = 'button'; btnDel.textContent = '×'; btnDel.setAttribute('aria-label', `Xóa slide ${i + 1}`);
          btnDel.addEventListener('click', () => {
            slides.splice(i, 1);
            if (!slides.length) slides = DEFAULT_SLIDES.map(x => ({ ...x }));
            if (active >= slides.length) active = 0;
            markDirty(); renderPanel(); renderView();
          });
          actions.append(btnChange, btnDel);
          thumb.append(im, actions);
          thumb.addEventListener('dragstart', (e) => {
            e.dataTransfer.setData('text/plain', String(i));
            thumb.classList.add('dragging');
          });
          thumb.addEventListener('dragend', () => thumb.classList.remove('dragging'));
          thumb.addEventListener('dragover', (e) => e.preventDefault());
          thumb.addEventListener('drop', (e) => {
            e.preventDefault();
            const from = parseInt(e.dataTransfer.getData('text/plain'), 10);
            if (Number.isNaN(from) || from === i) return;
            const [moved] = slides.splice(from, 1);
            slides.splice(i, 0, moved);
            markDirty(); renderPanel(); renderView();
          });
          panel.appendChild(thumb);
        });
      };
      renderPanel();

      toolbar.querySelector('[data-add]').addEventListener('click', () => openPicker(({ src, alt }) => {
        slides.push({ src, alt });
        markDirty(); renderPanel(); renderView();
        if (hint) hint.textContent = `Đã thêm slide ${slides.length} — chưa lưu.`;
      }));
      toolbar.querySelector('[data-save]').addEventListener('click', () => {
        localStorage.setItem(LS_SLIDES, JSON.stringify(slides));
        dirty = false;
        if (hint) hint.textContent = 'Đã lưu ✓ (bỏ ?edit để xem carousel).';
      });
      toolbar.querySelector('[data-export]').addEventListener('click', async () => {
        const json = JSON.stringify({ slides_identity: slides, site_images: readImages(), amenities_slides: readAmSlides() }, null, 2);
        if (await copyText(json)) {
          if (hint) hint.textContent = 'Đã copy JSON (slides_identity + site_images + amenities_slides) — dán vào chat.';
        } else {
          if (hint) hint.textContent = 'Copy lỗi — mở console (F12) lấy JSON.';
          console.log('[bmt export]', json);
        }
      });
      toolbar.querySelector('[data-reset]').addEventListener('click', () => {
        localStorage.removeItem(LS_SLIDES);
        localStorage.removeItem(LS_IMAGES);
        location.reload();
      });

      // ——— Edit mode: slide ảnh nền khu amenities ———
      if (amSection) {
        const amToolbar = document.createElement('div');
        amToolbar.className = 'v2-edit-toolbar';
        amToolbar.innerHTML = `
          <span class="v2-edit-tag">✦ ẢNH NỀN TIỆN ÍCH</span>
          <button type="button" data-add>+ Thêm ảnh</button>
          <button type="button" data-save>💾 Lưu</button>
          <button type="button" data-export>📋 Xuất JSON</button>
          <button type="button" data-reset>↺ Reset</button>
          <span class="v2-edit-hint" data-hint>Thêm/đổi/xóa slide, kéo thả đổi thứ tự → Lưu.</span>`;
        amSection.appendChild(amToolbar);
        const amHint = amToolbar.querySelector('[data-hint]');
        const amMarkDirty = () => { if (amHint) amHint.textContent = 'Chưa lưu — bấm 💾 Lưu.'; };

        const amPanel = document.createElement('div');
        amPanel.className = 'v2-slides-panel';
        amSection.appendChild(amPanel);
        const amRenderPanel = () => {
          amPanel.innerHTML = '';
          amSlides.forEach((s, i) => {
            const thumb = document.createElement('div');
            thumb.className = 'v2-slide-thumb';
            thumb.draggable = true;
            const im = document.createElement('img');
            im.src = s.src; im.alt = s.alt || `Slide ${i + 1}`;
            const actions = document.createElement('div');
            actions.className = 'thumb-actions';
            const btnChange = document.createElement('button');
            btnChange.type = 'button'; btnChange.textContent = 'Đổi';
            btnChange.addEventListener('click', () => openPicker(({ src, alt }) => {
              amSlides[i] = { src, alt };
              amMarkDirty(); amRenderPanel(); amRenderView();
              if (amHint) amHint.textContent = `Đã đổi slide ${i + 1} — chưa lưu.`;
            }));
            const btnDel = document.createElement('button');
            btnDel.type = 'button'; btnDel.textContent = '×'; btnDel.setAttribute('aria-label', `Xóa slide ${i + 1}`);
            btnDel.addEventListener('click', () => {
              amSlides.splice(i, 1);
              if (!amSlides.length) amSlides = DEFAULT_AM_SLIDES.map(x => ({ ...x }));
              if (amActive >= amSlides.length) amActive = 0;
              amMarkDirty(); amRenderPanel(); amRenderView();
            });
            actions.append(btnChange, btnDel);
            thumb.append(im, actions);
            thumb.addEventListener('dragstart', (e) => {
              e.dataTransfer.setData('text/plain', String(i));
              thumb.classList.add('dragging');
            });
            thumb.addEventListener('dragend', () => thumb.classList.remove('dragging'));
            thumb.addEventListener('dragover', (e) => e.preventDefault());
            thumb.addEventListener('drop', (e) => {
              e.preventDefault();
              const from = parseInt(e.dataTransfer.getData('text/plain'), 10);
              if (Number.isNaN(from) || from === i) return;
              const [moved] = amSlides.splice(from, 1);
              amSlides.splice(i, 0, moved);
              amMarkDirty(); amRenderPanel(); amRenderView();
            });
            amPanel.appendChild(thumb);
          });
        };
        amRenderPanel();

        amToolbar.querySelector('[data-add]').addEventListener('click', () => openPicker(({ src, alt }) => {
          amSlides.push({ src, alt });
          amMarkDirty(); amRenderPanel(); amRenderView();
          if (amHint) amHint.textContent = `Đã thêm slide ${amSlides.length} — chưa lưu.`;
        }));
        amToolbar.querySelector('[data-save]').addEventListener('click', () => {
          localStorage.setItem(LS_AMEN, JSON.stringify(amSlides));
          if (amHint) amHint.textContent = 'Đã lưu ✓ (bỏ ?edit để xem slide chạy).';
        });
        amToolbar.querySelector('[data-export]').addEventListener('click', async () => {
          const json = JSON.stringify({ slides_identity: slides, site_images: readImages(), amenities_slides: amSlides }, null, 2);
          if (await copyText(json)) {
            if (amHint) amHint.textContent = 'Đã copy JSON (slides_identity + site_images + amenities_slides) — dán vào chat.';
          } else {
            if (amHint) amHint.textContent = 'Copy lỗi — mở console (F12) lấy JSON.';
            console.log('[bmt export]', json);
          }
        });
        amToolbar.querySelector('[data-reset]').addEventListener('click', () => {
          localStorage.removeItem(LS_AMEN);
          location.reload();
        });
      }

      // Nút [Đổi ảnh] trên từng ảnh data-editable-img
      editableImgs.forEach(el => {
        const key = el.dataset.editableImg;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'v2-img-edit-btn' + (key === 'hero' ? ' is-hero' : key === 'poster' ? ' is-poster' : '');
        btn.textContent = key === 'poster' ? 'Đổi poster' : 'Đổi ảnh';
        const targetParent = key === 'hero' 
          ? (document.querySelector('.v2-hero') || el.parentElement || figure) 
          : key === 'poster' 
            ? (el.closest('.cinematic-frame') || el.parentElement || figure)
            : (el.parentElement || figure);
        targetParent.appendChild(btn);
        btn.addEventListener('click', () => openPicker(({ src, alt }) => {
          const cur = readImages();
          if (key === 'poster') {
            cur[key] = { src };
            applySiteImage(key, cur[key]);
          } else {
            const currentAlt = (el instanceof HTMLImageElement ? el.alt : '') || alt;
            cur[key] = { src, alt: alt || currentAlt };
            applySiteImage(key, cur[key]);
          }
          localStorage.setItem(LS_IMAGES, JSON.stringify(cur));
        }));
      });
    })();
  </script>
</MainLayout>
