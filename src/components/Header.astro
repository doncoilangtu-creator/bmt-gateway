---
---
<header class="site-header" data-site-header>
  <a class="header-menu" href="#project" aria-label="Khám phá dự án">
    <span aria-hidden="true"></span>
    <span>Khám phá</span>
  </a>

  <a class="brand-lockup" href="#top" aria-label="EraCity trang chủ">
    <strong>Era</strong>
    <span>City</span>
  </a>

  <a class="header-inquiry" href="#inquiry">
    <span aria-hidden="true">→</span>
    <span>Nhận tư vấn</span>
  </a>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const footer = document.querySelector('.footer-soho');
  const locationMap = document.querySelector('[data-location-map]');
  const syncHeaderVisibility = () => {
    if (!header) return;
    const hidden = header.classList.contains('is-footer-visible') || header.classList.contains('is-map-immersive');
    header.setAttribute('aria-hidden', String(hidden));
    if (hidden) {
      header.style.setProperty('transform', 'translateY(-105%)', 'important');
      header.style.setProperty('opacity', '0', 'important');
      header.style.setProperty('pointer-events', 'none', 'important');
    } else {
      header.style.removeProperty('transform');
      header.style.removeProperty('opacity');
      header.style.removeProperty('pointer-events');
    }
  };
  const updateHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 80);
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  if (header && footer) {
    const footerObserver = new IntersectionObserver(([entry]) => {
      const hidden = entry.isIntersecting;
      header.classList.toggle('is-footer-visible', hidden);
      syncHeaderVisibility();
    }, { threshold: 0.02 });
    footerObserver.observe(footer);
  }

  if (header && locationMap) {
    const mapObserver = new IntersectionObserver(([entry]) => {
      const immersive = entry.isIntersecting && entry.intersectionRatio >= 0.42;
      header.classList.toggle('is-map-immersive', immersive);
      syncHeaderVisibility();
    }, { threshold: [0, .42, .7] });
    mapObserver.observe(locationMap);
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 76px;
    padding: 0 clamp(20px, 3vw, 52px);
    color: #fffaf1;
    transition: color .45s ease, background .45s ease, backdrop-filter .45s ease, box-shadow .45s ease, transform .5s cubic-bezier(.16,1,.3,1), opacity .35s ease;
    will-change: transform, opacity;
  }
  :global(.site-header.is-footer-visible) { transform: translateY(-105%); opacity:0; pointer-events:none; }
  :global(.site-header.is-map-immersive) { transform: translateY(-105%) !important; opacity:0 !important; pointer-events:none !important; }
  .site-header.is-scrolled {
    color: #2d1b13;
    background: rgba(244,235,221,.9);
    backdrop-filter: blur(18px);
    box-shadow: 0 1px 0 rgba(45,27,19,.12);
  }
  .header-menu, .header-inquiry { display:flex; align-items:center; gap:12px; width:max-content; min-height:44px; font-family:var(--font-label); font-size:11px; font-weight:600; letter-spacing:.11em; text-transform:uppercase; }
  .header-menu span:first-child { display:block; width:28px; height:1px; background:currentColor; position:relative; }
  .header-menu span:first-child::after { content:''; position:absolute; left:0; top:6px; width:18px; height:1px; background:currentColor; }
  .brand-lockup { display:grid; justify-items:center; min-width:65px; min-height:44px; align-content:center; line-height:.9; letter-spacing:.16em; text-transform:uppercase; }
  .brand-lockup strong { font-family:var(--font-heading); font-size:19px; font-weight:600; }
  .brand-lockup span { margin-top:7px; font-family:var(--font-label); font-size:10px; letter-spacing:.32em; }
  .header-inquiry { justify-self:end; min-height:76px; padding-left:24px; border-left:1px solid currentColor; }
  .header-inquiry > span:first-child { font-size:18px; transition:transform .3s ease; }
  .header-inquiry:hover > span:first-child { transform:translateX(5px); }
  @media (max-width:700px) {
    .site-header { min-height:60px; grid-template-columns:44px 1fr auto; padding:0 12px; }
    .header-menu { width:44px; justify-content:flex-start; }
    .header-menu span:last-child { display:none; }
    .brand-lockup { justify-self:center; }
    .header-inquiry { min-height:44px; padding:0 0 0 10px; }
    .header-inquiry span:last-child { font-size:10px; white-space:nowrap; }
  }
  @media (prefers-reduced-motion:reduce) {
    .site-header { transition: none; }
  }
</style>
