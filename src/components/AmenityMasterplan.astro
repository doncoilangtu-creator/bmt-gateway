<section id="amenity-masterplan" class="amenity-masterplan" data-amenity-masterplan data-chapter aria-labelledby="amenity-masterplan-title">
  <div class="amenity-masterplan-heading"><p class="v2-editorial">04 / Landscape & Amenities</p><h2 id="amenity-masterplan-title">HỆ TIỆN ÍCH<br /><em>ĐẶC QUYỀN ĐA DẠNG</em></h2><p>Đọc toàn bộ lớp cảnh quan, mặt nước, vận động và cộng đồng trong masterplan của EraCity.</p></div>
  <div class="amenity-masterplan-stage" data-amenity-stage>
    <div class="amenity-masterplan-canvas" data-amenity-canvas><div class="amenity-map-fit" data-amenity-fit data-fit-ratio="wide"><img src="/images/amenities/amenity-masterplan-p15e.webp" alt="Mặt bằng tổng thể cảnh quan EraCity từ hồ sơ StudioMilou" loading="eager" />{pinsDesktop.map(([number, label, left, top]) => <button class="amenity-pin" type="button" style={`--pin-left:${left};--pin-top:${top}`} data-amenity-pin={number} aria-label={`${number} ${label}`}><b>{number}</b><span>{label}</span></button>)}</div></div>
    <div class="amenity-map-controls" aria-label="Điều khiển mặt bằng tiện ích"><button type="button" data-amenity-zoom-out aria-label="Thu nhỏ">−</button><span data-amenity-zoom>100%</span><button type="button" data-amenity-zoom-in aria-label="Phóng to">+</button></div><p class="amenity-source">Nguồn: studioMilou · Master plan · 04.2026</p>
    <div class="amenity-edit-toolbar" data-edit-toolbar hidden>
      <span class="amenity-edit-tag">✦ CHỈNH PIN</span>
      <button type="button" data-edit-save>💾 Lưu vị trí</button>
      <button type="button" data-edit-export>📋 Xuất JSON</button>
      <button type="button" data-edit-reset>↺ Reset</button>
      <span class="amenity-edit-hint" data-edit-hint>Kéo từng pin vào đúng số trên hình → Lưu.</span>
    </div>
  </div>
  <aside class="amenity-rail" aria-label="Danh mục hệ tiện ích">
    <div class="amenity-rail-intro"><span>01—04</span><strong>Những lớp tiện ích<br />đi qua mỗi ngày</strong></div>
    <div class="amenity-list amenity-list-primary" aria-label="Tiện ích tiếp cận">
      {[['01', 'Biển hiệu'], ['02', 'Hồ nước điểm nhấn'], ['03', 'Cảnh quan chào đón'], ['04', 'Quảng trường']].map(([number, label]) => <button type="button" data-amenity-focus={number}><b>{number}</b><span>{label}</span></button>)}
    </div>
    {groups.map((group, index) => (
      <div class={`amenity-group ${index === 0 ? 'is-open' : ''}`} data-group-id={group.id}>
        <button type="button" class="amenity-group-summary" aria-expanded={index === 0 ? 'true' : 'false'}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          {group.label}
          <i>⌄</i>
        </button>
        <div class="amenity-group-body">
          <div class="amenity-list">
            {group.items.map(([number, label]) => <button type="button" data-amenity-focus={number}><b>{number}</b><span>{label}</span></button>)}
          </div>
        </div>
      </div>
    ))}
  </aside>
</section>

<script>
  // ——— Chế độ chỉnh vị trí pin trực tiếp trên giao diện ———
  // Bật: thêm ?edit=1 vào URL (hoặc a[id] trong localStorage). Kéo pin → Lưu (localStorage) / Xuất JSON (dán vào code).
  (() => {
    const LS_KEY = 'bmt_amenity_pins';
    const canvas = document.querySelector('[data-amenity-canvas]');
    const pins = Array.from(document.querySelectorAll('[data-amenity-pin]'));
    const toolbar = document.querySelector('[data-edit-toolbar]');
    const hint = document.querySelector('[data-edit-hint]');
    if (!canvas || !pins.length || !toolbar) return;

    const isEdit = new URLSearchParams(location.search).has('edit') || localStorage.getItem('bmt_amenity_edit') === '1';
    if (!isEdit) return;

    document.body.classList.add('amenity-edit-mode');
    toolbar.hidden = false;
    let dirty = false;

    const clamp = (v) => Math.min(97, Math.max(3, v));

    const store = () => {
      const out = {};
      pins.forEach(p => { out[p.dataset.amenityPin] = { left: p.style.left, top: p.style.top }; });
      localStorage.setItem(LS_KEY, JSON.stringify(out));
      dirty = false;
      if (hint) hint.textContent = 'Đã lưu ✓ (F5 để xem lại).';
    };

    const exportJson = async () => {
      const out = {};
      pins.forEach(p => { out[p.dataset.amenityPin] = { left: p.style.left, top: p.style.top }; });
      const json = JSON.stringify(out, null, 0);
      try {
        await navigator.clipboard.writeText(json);
        if (hint) hint.textContent = 'Đã copy JSON — dán vào pins[] của AmenityMasterplan.astro.';
      } catch (e) {
        if (hint) hint.textContent = json;
      }
    };

    const resetAll = () => {
      localStorage.removeItem(LS_KEY);
      location.reload();
    };

    // Áp dụng vị trí đã lưu (nếu có)
    try {
      const saved = JSON.parse(localStorage.getItem(LS_KEY) || '{}');
      pins.forEach(p => {
        const s = saved[p.dataset.amenityPin];
        if (s) { p.style.left = s.left; p.style.top = s.top; }
      });
    } catch (e) {}

    // Kéo thả pin
    let drag = null;
    const onPointerDown = (e) => {
      if (e.target.closest('button:not([data-amenity-pin])')) return;
      const pin = e.target.closest('[data-amenity-pin]');
      if (!pin) return;
      e.preventDefault();
      e.stopPropagation();
      pin.setPointerCapture(e.pointerId);
      drag = { pin, id: pin.dataset.amenityPin, dx: 0, dy: 0 };
    };
    const onPointerMove = (e) => {
      if (!drag) return;
      const rect = canvas.getBoundingClientRect();
      const l = clamp(((e.clientX - rect.left) / rect.width) * 100);
      const t = clamp(((e.clientY - rect.top) / rect.height) * 100);
      drag.pin.style.left = l + '%';
      drag.pin.style.top = t + '%';
      dirty = true;
      if (hint) hint.textContent = `Pin ${drag.id}: ${l.toFixed(1)}% / ${t.toFixed(1)}%`;
    };
    const onPointerUp = (e) => {
      if (!drag) return;
      try { drag.pin.releasePointerCapture(e.pointerId); } catch (err) {}
      drag = null;
    };
    canvas.addEventListener('pointerdown', onPointerDown);
    canvas.addEventListener('pointermove', onPointerMove);
    canvas.addEventListener('pointerup', onPointerUp);
    canvas.addEventListener('pointercancel', onPointerUp);

    toolbar.querySelector('[data-edit-save]').addEventListener('click', store);
    toolbar.querySelector('[data-edit-export]').addEventListener('click', exportJson);
    toolbar.querySelector('[data-edit-reset]').addEventListener('click', resetAll);
  })();
</script>

<style>
  .amenity-edit-mode .amenity-pin {
    cursor: grab;
    outline: 1.5px dashed #e8362b;
    outline-offset: 4px;
    background: rgba(232, 54, 43, .08);
    border-radius: 6px;
  }
  .amenity-edit-mode .amenity-pin:active { cursor: grabbing; }
  .amenity-edit-toolbar {
    position: absolute; z-index: 30; left: 12px; top: 12px;
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    padding: 8px 10px; background: rgba(45, 27, 19, .92); color: #fff8ef;
    font: 600 10px/1 var(--font-label); letter-spacing: .1em; text-transform: uppercase;
    border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.3); backdrop-filter: blur(6px);
  }
  .amenity-edit-toolbar button {
    min-height: 30px; padding: 0 10px; border: 0; border-radius: 4px;
    background: #f4ebdd; color: #2d1b13; font: inherit; cursor: pointer;
  }
  .amenity-edit-toolbar button:hover { background: #d8a37e; }
  .amenity-edit-tag { color: #d8a37e; }
  .amenity-edit-hint { max-width: 260px; color: rgba(255,248,239,.75); text-transform: none; letter-spacing: 0; font-size: 10px; }
</style>
